# ============================================================
# Patient Engagement — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ----- Database ----------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/patient_engagement

# ----- Open Dental API ---------------------------------------
OPEN_DENTAL_API_BASE_URL=https://api.opendental.com/api/v1
OPEN_DENTAL_CUSTOMER_KEY=your_customer_key_here
OPEN_DENTAL_DEVELOPER_KEY=your_developer_key_here

# ----- Application -------------------------------------------
SESSION_SECRET=careconnect-dev-session-secret-key-must-be-at-least-32-chars

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional direct authorization header format (e.g. ODFHIR NFF6i0KrXrxDkZHt/VzkmZEaUWOjnQX2z)
OPEN_DENTAL_AUTHORIZATION=ODFHIR NFF6i0KrXrxDkZHt/VzkmZEaUWOjnQX2z
